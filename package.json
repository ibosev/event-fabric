{
  "name": "event-fabric",
  "version": "0.0.0",
  "private": true,
  "description": "Event-sourced CQRS framework: Aggregates, Readmodels, Sagas, Gateways, Workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibosev/event-fabric.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./mongo": {
      "types": "./dist/mongo.d.ts",
      "default": "./dist/mongo.js"
    },
    "./rabbitmq": {
      "types": "./dist/rabbitmq.d.ts",
      "default": "./dist/rabbitmq.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "default": "./dist/compat.js"
    },
    "./decorators": {
      "types": "./dist/decorators.d.ts",
      "default": "./dist/decorators.js"
    },
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin.d.ts",
      "default": "./dist/eslint-plugin.js"
    },
    "./migration": {
      "types": "./dist/migration.d.ts",
      "default": "./dist/migration.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    }
  },
  "bin": {
    "event-fabric": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "lint": "eslint dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "qs": "^6.16.1",
    "typebox": "^1.3.34"
  },
  "peerDependencies": {
    "amqplib": "^0.10.9",
    "mongodb": "^7.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qs": "^6.15.1",
    "@types/ws": "^8.18.2",
    "amqplib": "^0.10.9",
    "eslint": "^10.12.0",
    "mongodb": "^7.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
